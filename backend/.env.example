APP_NAME="KPI System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-url.run.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-cloud-sql-ip
DB_PORT=3306
DB_DATABASE=kpi_system
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

GCP_PROJECT_ID=your-gcp-project-id

FILESYSTEM_DISK=gcs
GCS_BUCKET=your-bucket-name
GCS_PATH_PREFIX=evidence

SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.run.app,your-mobile-domain.run.app

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
